# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Analytics (optional — analytics remain disabled when unset) ---

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity Project ID
NEXT_PUBLIC_CLARITY_ID=

# --- Webmaster Verification (optional — omit if not using) ---

# Google Search Console HTML-tag verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# Bing Webmaster Tools verification token
NEXT_PUBLIC_BING_VERIFICATION=

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=
